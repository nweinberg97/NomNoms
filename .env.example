# NomNoms public configuration — copy to .env and fill in.
# These are PUBLIC client IDs (safe in the browser). Never put secrets here.
# Leave blank and the sign-in buttons open a private demo account instead.

# Google Identity Services (OAuth 2.0 Web client ID)
# https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:5173 and your production origin
GOOGLE_CLIENT_ID=

# Sign in with Apple (Services ID, e.g. com.example.nomnoms.web)
# https://developer.apple.com/account/resources/identifiers/list/serviceId
# Register your domain and return URL; Apple requires HTTPS (not localhost).
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
